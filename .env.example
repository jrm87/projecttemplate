# Environment variables for this project.
# Copy to .env and fill in your values. Never commit .env to git.

# CUSTOMIZE: Add your project-specific variables below

# Example: Census API key (for tidycensus, etc.)
# CENSUS_API_KEY=your_key_here

# Example: OpenAI API key (if using LLM tasks)
# OPENAI_API_KEY=sk-proj-...

# Example: TACC repo path override (if non-standard)
# TACC_REPO_PATH=/work/10520/myuser/ls6/myproject

# Example: DCC repo path override (if non-standard)
# DCC_REPO_PATH=/hpc/group/econ/myuser/myproject
